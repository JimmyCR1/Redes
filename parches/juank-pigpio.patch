diff --git a/faro/serie_pigpio.py b/faro/serie_pigpio.py
new file mode 100644
index 0000000..0b33fab
--- /dev/null
+++ b/faro/serie_pigpio.py
@@ -0,0 +1,84 @@
+"""Puerto serie por software con pigpio, para un Faro cableado a GPIO17/GPIO27.
+
+Se usa con --uart pigpio en lugar de /dev/ttyAMA0. Se comporta como el
+objeto serial de pyserial que espera MedioUART (write, flush, in_waiting,
+read, reset_input_buffer, close), asi el resto del codigo no cambia.
+
+Diferencias con el Faro de la UART de hardware:
+    GPIO17 (pin 11) TX hacia el 2N2222A del LED IR
+    GPIO27 (pin 13) RX desde el colector del fototransistor, con 10 k a 3V3:
+                    con luz lee 0, por eso la lectura se invierte.
+
+Requiere el servicio pigpiod: sudo systemctl enable --now pigpiod
+"""
+import time
+
+PIN_TX = 17
+PIN_RX = 27
+# Byte extra al final: el lector de pigpio cierra cada byte con el siguiente
+# cambio de luz. Sin el, los ultimos bits en 1 de la senal se leian como 0.
+# 0x55 son cuatro pares Manchester validos, asi no ensucia la senal.
+RELLENO = b"\x55"
+
+
+class SeriePigpio:
+    def __init__(self, baudios: int = 9600, pin_tx: int = PIN_TX,
+                 pin_rx: int = PIN_RX, invertir_rx: bool = True, pi=None):
+        if pi is None:
+            import pigpio  # solo se necesita en la Raspberry
+            pi = pigpio.pi()
+            if not pi.connected:
+                raise RuntimeError("no se pudo conectar con pigpiod "
+                                   "(sudo systemctl enable --now pigpiod)")
+        self.pi = pi
+        self.baudios = baudios
+        self.pin_tx, self.pin_rx = pin_tx, pin_rx
+        self._buf = bytearray()
+        self.pi.set_mode(pin_tx, 1)          # salida
+        self.pi.write(pin_tx, 1)             # reposo UART = LED IR encendido
+        self.pi.bb_serial_read_open(pin_rx, baudios, 8)
+        if invertir_rx:
+            self.pi.bb_serial_invert(pin_rx, 1)
+
+    def _leer_pendiente(self) -> None:
+        cantidad, datos = self.pi.bb_serial_read(self.pin_rx)
+        if cantidad > 0:
+            self._buf += datos
+
+    @property
+    def in_waiting(self) -> int:
+        self._leer_pendiente()
+        return len(self._buf)
+
+    def read(self, n: int) -> bytes:
+        self._leer_pendiente()
+        datos = bytes(self._buf[:n])
+        del self._buf[:n]
+        return datos
+
+    def write(self, datos: bytes) -> int:
+        """Transmite y espera a que salga el ultimo bit."""
+        self.pi.wave_add_new()
+        self.pi.wave_add_serial(self.pin_tx, self.baudios, bytes(datos) + RELLENO)
+        onda = self.pi.wave_create()
+        try:
+            self.pi.wave_send_once(onda)
+            while self.pi.wave_tx_busy():
+                time.sleep(0.005)
+        finally:
+            self.pi.wave_delete(onda)
+        return len(datos)
+
+    def flush(self) -> None:
+        pass   # write ya espera a que termine la onda
+
+    def reset_input_buffer(self) -> None:
+        self._leer_pendiente()
+        self._buf.clear()
+
+    def close(self) -> None:
+        try:
+            self.pi.bb_serial_read_close(self.pin_rx)
+            self.pi.write(self.pin_tx, 0)
+        finally:
+            self.pi.stop()
diff --git a/tests/test_serie_pigpio.py b/tests/test_serie_pigpio.py
new file mode 100644
index 0000000..fd681ad
--- /dev/null
+++ b/tests/test_serie_pigpio.py
@@ -0,0 +1,77 @@
+"""SeriePigpio sin hardware: un pigpio falso que devuelve por RX lo que sale por TX,
+imitando el defecto real del lector de pigpio en el ultimo byte."""
+from faro import frame, linea
+from faro.medio import MedioUART
+from faro.serie_pigpio import RELLENO, SeriePigpio
+
+A, B = b"\xaa\xaa\xaa\xaa", b"\xbb\xbb\xbb\xbb"
+
+
+def _perder_unos_finales(byte: int) -> int:
+    """Asi llego el ultimo byte en la Raspberry: d5 -> 15, ff -> 00."""
+    for bit in range(7, -1, -1):
+        if not byte & (1 << bit):
+            break
+        byte &= ~(1 << bit)
+    return byte
+
+
+class PigpioEspejo:
+    def __init__(self):
+        self.rx = bytearray()
+        self.niveles = {}
+
+    def set_mode(self, pin, modo): pass
+    def write(self, pin, nivel): self.niveles[pin] = nivel
+    def bb_serial_read_open(self, pin, baudios, bits): pass
+    def bb_serial_invert(self, pin, invertir): pass
+    def bb_serial_read_close(self, pin): pass
+    def wave_add_new(self): pass
+    def wave_create(self): return 0
+    def wave_send_once(self, onda): pass
+    def wave_tx_busy(self): return False
+    def wave_delete(self, onda): pass
+    def stop(self): pass
+
+    def wave_add_serial(self, pin, baudios, datos):
+        datos = bytearray(datos)
+        datos[-1] = _perder_unos_finales(datos[-1])
+        self.rx += datos
+
+    def bb_serial_read(self, pin):
+        datos, self.rx = bytes(self.rx), bytearray()
+        return len(datos), datos
+
+
+def test_defecto_simulado_coincide_con_la_raspberry():
+    assert _perder_unos_finales(0xD5) == 0x15
+    assert _perder_unos_finales(0xFF) == 0x00
+
+
+def test_relleno_es_manchester_valido():
+    assert linea.manchester_decodificar(linea.bytes_a_bits(RELLENO)) == [1, 1, 1, 1]
+
+
+def test_trama_llega_completa_aunque_se_dane_el_ultimo_byte():
+    medio = MedioUART(baudios=1200, serial_obj=SeriePigpio(1200, pi=PigpioEspejo()))
+    for payload in (b"", b"hola faro", b"\xff" * frame.MAX_PAYLOAD):
+        trama = frame.codificar(frame.Trama(frame.TIPO_DATA, A, B, 7, payload))
+        medio.enviar(linea.armar_senal(trama))
+        assert linea.extraer_trama(medio.recibir(1.0)) == trama
+
+
+def test_reposo_enciende_el_led_y_cerrar_lo_apaga():
+    pi = PigpioEspejo()
+    serie = SeriePigpio(pi=pi)
+    assert pi.niveles[17] == 1
+    serie.close()
+    assert pi.niveles[17] == 0
+
+
+def test_loopback_de_medir_con_pigpio(monkeypatch):
+    from faro import medir
+    monkeypatch.setattr(medir, "crear_medio",
+                        lambda a: MedioUART(serial_obj=SeriePigpio(pi=PigpioEspejo())))
+    a = type("A", (), {"tramas": 3, "espera_ack": 0.5, "pausa": 0.0})()
+    recibidas, errores = medir.cmd_loopback(a)
+    assert recibidas == 3 and errores == 0
